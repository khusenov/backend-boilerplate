{
  "name": "backend-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Clean-architecture TypeScript backend boilerplate built on Fastify, Awilix and Prisma",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "start:worker": "node --import ./dist/instrumentation.js dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise src && node scripts/assert-arch-not-vacuous.mjs",
    "arch:graph": "{ echo '```mermaid'; depcruise src --include-only '^src' --output-type mermaid --collapse '^src/[^/]+'; echo '```'; } > docs/architecture-graph.md",
    "verify:lock": "npm ci --dry-run --ignore-scripts",
    "deps:audit": "npm audit --omit=dev --audit-level=high",
    "audit": "npm run verify:lock && npm run deps:audit && npm run format:check && npm run lint && npm run typecheck && npm run arch && npm run build && npm run test:coverage && npm run test:integration",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:sync-auth": "tsx src/scripts/sync-auth.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "boilerplate",
    "clean-architecture",
    "fastify",
    "awilix",
    "prisma",
    "typescript"
  ],
  "author": "Sardorbek Khusenov",
  "license": "MIT",
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@testcontainers/mariadb": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "concurrently": "^10.0.7",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.1",
    "vitest-mock-extended": "^5.1.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "esbuild": "~0.28.1",
    "mariadb": "~3.4.7",
    "mysql2": "~3.23.1"
  },
  "dependencies": {
    "@bull-board/api": "^9.11.0",
    "@bull-board/fastify": "^9.11.0",
    "@fastify/accepts": "^5.0.7",
    "@fastify/awilix": "^8.3.2",
    "@fastify/basic-auth": "^6.3.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/request-context": "^7.0.5",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/instrumentation": "^7.10.1",
    "awilix": "^13.0.5",
    "bullmq": "^6.7.2",
    "close-with-grace": "^2.5.0",
    "dotenv": "^18.0.9",
    "envalid": "^8.2.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "intl-messageformat": "^12.1.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "nodemailer": "^10.4.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
