{
  "name": "backend-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Clean-architecture TypeScript backend boilerplate built on Fastify, Awilix and Prisma",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "start:worker": "node --import ./dist/instrumentation.js dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise src && depcruise src --output-type json | node scripts/assert-arch-not-vacuous.mjs",
    "arch:graph": "{ echo '```mermaid'; depcruise src --include-only '^src' --output-type mermaid --collapse '^src/[^/]+'; echo '```'; } > docs/architecture-graph.md",
    "verify:lock": "npm ci --dry-run --ignore-scripts",
    "deps:audit": "npm audit --omit=dev --audit-level=high",
    "audit": "npm run verify:lock && npm run deps:audit && npm run format:check && npm run lint && npm run typecheck && npm run arch && npm run build && npm run test:coverage && npm run test:integration",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:sync-auth": "tsx src/scripts/sync-auth.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "boilerplate",
    "clean-architecture",
    "fastify",
    "awilix",
    "prisma",
    "typescript"
  ],
  "author": "Sardorbek Khusenov",
  "license": "MIT",
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@testcontainers/mariadb": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prisma": "^7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "vitest-mock-extended": "^5.1.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/fastify": "^9.10.1",
    "@fastify/awilix": "^8.2.1",
    "@fastify/basic-auth": "^6.3.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.0.0",
    "@node-rs/argon2": "^2.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/instrumentation": "^7.10.0",
    "awilix": "^13.0.5",
    "bullmq": "^6.3.8",
    "close-with-grace": "^2.5.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
