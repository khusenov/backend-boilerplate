NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
DATABASE_URL=mysql://user:password@localhost:3306/finflow
# HMAC signing key for access tokens. Min 32 chars in production (enforced at boot).
# Replace before any real deploy — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-32+-char-random-string
JWT_ISSUER=finflow
JWT_AUDIENCE=finflow-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
# Signs the refresh cookie. Min 32 chars in production; empty disables signing in dev.
# Replace before any real deploy — generate with: openssl rand -base64 48
COOKIE_SECRET=change-me-to-a-32+-char-random-cookie-secret
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@finflow.com
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"
RATE_LIMIT_AUTH_MAX=5
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=finflow
QUEUE_CONCURRENCY=5
METRICS_ENABLED=true
HEALTHCHECK_TIMEOUT_MS=2000
