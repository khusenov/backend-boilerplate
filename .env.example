# Drives the default service, queue, token-issuer and dashboard names below.
# Change this one value to rebrand the app; the values it derives are left
# commented out so they follow it. The compose project name and
# docker/alloy/config.alloy must be renamed by hand to match (see README).
APP_NAME=app
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
WORKER_PORT=8001
LOG_LEVEL=info
DATABASE_URL=mysql://app:app@localhost:3306/app
# HMAC signing key for access tokens. Min 32 chars in production (enforced at boot).
# Replace before any real deploy — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-32+-char-random-string
# Derived from APP_NAME as `<APP_NAME>` and `<APP_NAME>-api`. Uncomment to override.
#JWT_ISSUER=app
#JWT_AUDIENCE=app-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
# Signs the refresh cookie. Min 32 chars in production; empty disables signing in dev.
# Replace before any real deploy — generate with: openssl rand -base64 48
COOKIE_SECRET=change-me-to-a-32+-char-random-cookie-secret
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"
RATE_LIMIT_AUTH_MAX=5
REDIS_URL=redis://127.0.0.1:6379
# Derived from APP_NAME. Uncomment to override.
#QUEUE_PREFIX=app
QUEUE_CONCURRENCY=5
DATA_RETENTION_TTL=2592000
IDEMPOTENCY_RESULT_TTL=86400
IDEMPOTENCY_LOCK_TTL=30
METRICS_ENABLED=true
HEALTHCHECK_TIMEOUT_MS=2000
# Tracing (OpenTelemetry) — disabled by default
OTEL_ENABLED=false
# Derived from APP_NAME as `<APP_NAME>-api`. The worker sets `<APP_NAME>-worker`.
#OTEL_SERVICE_NAME=app-api
OTEL_SERVICE_VERSION=0.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Sampling (read natively by the SDK). Sample everything in dev; lower in prod, e.g. 0.1
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
BULL_BOARD_ENABLED=false
BULL_BOARD_PATH=/admin/queues
BULL_BOARD_USERNAME=admin
# ≥16 chars in production; empty disables login (fail-closed)
BULL_BOARD_PASSWORD=change-me-to-a-16-char-min-password
BULL_BOARD_READONLY=true
# Outbound email (SMTP). Dev defaults target a local Mailpit catcher on :1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
# Derived from APP_NAME as `no-reply@<APP_NAME>.local` outside production; required in production.
#EMAIL_FROM=no-reply@app.local
VERIFICATION_CODE_TTL=900
VERIFICATION_MAX_ATTEMPTS=5
# HMAC pepper for email verification codes. Min 32 chars in production (enforced at boot).
# Replace before any real deploy — generate with: openssl rand -base64 48
VERIFICATION_CODE_SECRET=change-me-to-a-32+-char-random-string
PASSWORD_RESET_TOKEN_TTL=1800
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password
